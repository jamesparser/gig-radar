{
  "name": "gig-radar",
  "private": true,
  "version": "0.1.0",
  "description": "GigRadar finds the gigs that fit and drafts the pitch — you close the deal.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @gigradar/web",
    "build": "npm run build -w @gigradar/web",
    "build:extension": "npm run build -w @gigradar/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @gigradar/api",
    "db:migrate": "npm run db:migrate -w @gigradar/api",
    "stripe:setup": "npm run stripe:setup -w @gigradar/api"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
