# GigRadar environment. Copy to apps/web/.env.local for local development; set the same names in Vercel for production.
# With nothing set, local dev boots on an embedded Postgres (PGlite) with INSECURE dev secrets. Production refuses to boot without the required ones.

# --- Required in production ---------------------------------------------------------------------------------
# Postgres connection string (Neon pooled URL or Supabase). Leave unset locally to use embedded PGlite.
DATABASE_URL=
# Keep local dev data between restarts (ignored when DATABASE_URL is set). The path is relative to where you run `npm run dev`.
# PGLITE_DIR=./.data/pglite

# 32+ random characters each:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Signs license keys. Rotating it invalidates every key.
LICENSE_SECRET=

# Public origin of the app (auth callbacks, Stripe redirects, digest links). On Vercel it is derived if unset.
APP_URL=http://localhost:3000

# --- Billing (Stripe TEST mode) -----------------------------------------------------------------------------
# Create products/prices and the webhook with:  STRIPE_SECRET_KEY=sk_test_... npm run stripe:setup -- --webhook-url https://<app>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: the app also finds prices by lookup key (gigradar_pro_monthly / gigradar_studio_monthly).
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# --- AI drafts (optional; a labelled template is used without a key) ------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Or any OpenAI-compatible endpoint instead:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_PROVIDER=anthropic|openai|none     # force a choice if both keys are present

# --- Email digest (optional; digests land in the in-app outbox without a key) ---------------------------------
RESEND_API_KEY=
EMAIL_FROM="GigRadar <onboarding@resend.dev>"
# Bearer token Vercel Cron sends to /api/cron/digest
CRON_SECRET=

# --- Optional ---------------------------------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NEXT_PUBLIC_REPO_URL=https://github.com/jamesparser/gig-radar
# AUTO_MIGRATE=0            # skip applying embedded migrations on boot
# ALLOW_EPHEMERAL_DB=1      # production on an in-memory DB — throwaway demos only
# DB_POOL_MAX=5
