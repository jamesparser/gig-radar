{
  "name": "@gigradar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GigRadar API: Hono app (ingest, match, proposal drafts, digest, billing, license gate) on Postgres. Mounted by apps/web at /api, or run standalone.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gigradar/core": "*",
    "@hono/node-server": "^2.1.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
